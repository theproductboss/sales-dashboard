# Calendly (see README.md "Setup" section for how to get each of these)
CALENDLY_API_TOKEN=
CALENDLY_ORG_URI=
CALENDLY_OZ_USER_URI=
CALENDLY_BLAKE_USER_URI=

# Slack
SLACK_BOT_TOKEN=
CASH_REPORT_CHANNEL_ID=
DASHBOARD_CHANNEL_ID=

# Report behavior
REPORT_TIMEZONE=America/New_York

# Targets (override defaults if goals change)
WEEKLY_REVENUE_TARGET=37000
MONTHLY_REVENUE_FLOOR=100000
OZ_WEEKLY_CALL_TARGET=15
BLAKE_WEEKLY_CALL_TARGET=20

# Set to "true" to print the report to the console instead of posting to Slack
DRY_RUN=false

# --- Lead tracker (npm run leads) ---
# WebinarJam API key (see README "Lead tracker" setup)
WEBINARJAM_API_KEY=
# Which webinars to include: names containing this text (TEST webinars are always skipped)
WEBINARJAM_NAME_INCLUDES=Collective Webinar
# Or list exact webinar IDs instead, comma-separated
WEBINARJAM_WEBINAR_IDS=
# #collective-calls-booked and #payments (bot must be invited to both)
CALLS_BOOKED_CHANNEL_ID=C09UEM5M1V5
PAYMENTS_CHANNEL_ID=G017H4V9ACS
