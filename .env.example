# Calendly (see README.md "Setup" section for how to get each of these)
CALENDLY_API_TOKEN=
CALENDLY_ORG_URI=
CALENDLY_OZ_USER_URI=
CALENDLY_BLAKE_USER_URI=

# Slack
SLACK_BOT_TOKEN=
CASH_REPORT_CHANNEL_ID=
DASHBOARD_CHANNEL_ID=

# Report behavior
REPORT_TIMEZONE=America/New_York

# Targets (override defaults if goals change)
WEEKLY_REVENUE_TARGET=37000
MONTHLY_REVENUE_FLOOR=100000
OZ_WEEKLY_CALL_TARGET=15
BLAKE_WEEKLY_CALL_TARGET=20

# Set to "true" to print the report to the console instead of posting to Slack
DRY_RUN=false

# --- Closer tracker recap (npm run closer-recap) ---
# Google service account JSON (raw, or base64-encoded). The tracker must be
# shared with that account's client_email as a Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The spreadsheet ID from the tracker's URL:
# docs.google.com/spreadsheets/d/<THIS PART>/edit
CLOSER_TRACKER_SHEET_ID=
# Optional: link back to the tracker at the bottom of the Slack message.
CLOSER_TRACKER_URL=
# Channel the recap posts to.
CLOSER_RECAP_CHANNEL_ID=

# KPIs used for the ✅/⚠️/🔴 flags (as decimals). Show and offer come from
# the tracker itself; there's no stated close-rate KPI, so close rate is
# reported unflagged until CLOSE_RATE_KPI is set.
SHOW_RATE_KPI=0.7
OFFER_RATE_KPI=0.9
# CLOSE_RATE_KPI=0.25

# Force a recap style instead of the default (wrap on Friday, pulse
# otherwise): "pulse" or "wrap".
# RECAP_MODE=
# Pin which tabs to read, if month auto-detection ever picks wrong.
# CLOSER_TABS=Jill,Jacqueline,Oz
# CLOSER_TABS_EXCLUDE=Template
