# Calendly (see README.md "Setup" section for how to get each of these)
CALENDLY_API_TOKEN=
CALENDLY_ORG_URI=
CALENDLY_OZ_USER_URI=
CALENDLY_BLAKE_USER_URI=

# Slack
SLACK_BOT_TOKEN=
CASH_REPORT_CHANNEL_ID=
DASHBOARD_CHANNEL_ID=

# Revenue dashboard (see README.md "Revenue dashboard setup")
# Stripe: restricted key with read-only access to Charges, Refunds, Invoices
STRIPE_SECRET_KEY=
# PayPal: REST app credentials with "Transaction Search" enabled
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
# Where to post the revenue report (defaults to DASHBOARD_CHANNEL_ID if unset)
REVENUE_CHANNEL_ID=
REPORT_CURRENCY=usd

# Report behavior
REPORT_TIMEZONE=America/New_York

# Targets (override defaults if goals change)
WEEKLY_REVENUE_TARGET=37000
MONTHLY_REVENUE_FLOOR=100000
OZ_WEEKLY_CALL_TARGET=15
BLAKE_WEEKLY_CALL_TARGET=20

# Set to "true" to print the report to the console instead of posting to Slack
DRY_RUN=false
