# Calendly (see README.md "Setup" section for how to get each of these)
CALENDLY_API_TOKEN=
CALENDLY_ORG_URI=
CALENDLY_OZ_USER_URI=
CALENDLY_BLAKE_USER_URI=

# Slack
SLACK_BOT_TOKEN=
CASH_REPORT_CHANNEL_ID=
DASHBOARD_CHANNEL_ID=

# Report behavior
REPORT_TIMEZONE=America/New_York

# Targets (override defaults if goals change)
WEEKLY_REVENUE_TARGET=37000
MONTHLY_REVENUE_FLOOR=100000
OZ_WEEKLY_CALL_TARGET=15
BLAKE_WEEKLY_CALL_TARGET=20

# Set to "true" to print the report to the console instead of posting to Slack
DRY_RUN=false

# ---------------------------------------------------------------------------
# Zoom transcript pull (see README.md "Zoom call transcripts")
# ---------------------------------------------------------------------------

# Zoom Server-to-Server OAuth app, created on The Product Bosses Zoom account
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Whose calls to pull. Comma-separated Zoom login emails.
# Currently just Jill. Leave blank to pull every active user on the account
# (which also requires the broader user:read:list_users:admin scope).
ZOOM_HOST_EMAILS=jill@theproductboss.com

# Google Drive destination (service account — see README for the Shared Drive note)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
TRANSCRIPT_DRIVE_FOLDER_ID=
# Only needed if writing to a normal My Drive folder instead of a Shared Drive
GOOGLE_IMPERSONATE_SUBJECT=

# Optional topic keyword filters, comma-separated, case-insensitive.
# INCLUDE: if set, only meetings whose topic contains one of these are pulled.
# EXCLUDE: always wins over INCLUDE.
TRANSCRIPT_TOPIC_INCLUDE=
TRANSCRIPT_TOPIC_EXCLUDE=standup,internal,team sync

# How many days back to scan each run. Ranges over 30 days are chunked
# automatically (Zoom rejects a single request wider than one month).
TRANSCRIPT_LOOKBACK_DAYS=7
